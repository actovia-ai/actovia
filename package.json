{
  "name": "actovia",
  "version": "2.3.0",
  "private": true,
  "description": "ChatBot featuring MCP, Immersive Editor, RAG, AI Agents, Deep Research, and other modern capabilities.",
  "keywords": [],
  "homepage": "https://actovia.yancey.app",
  "license": "MIT",
  "author": {
    "name": "YanceyOfficial",
    "email": "yanceyofficial@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actovia-ai/actovia.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "main": ".vite/build/main.cjs",
  "scripts": {
    "dev": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true electron-forge start",
    "package": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true electron-forge package",
    "make": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true STRIP_TEST_IDS=1 electron-forge make",
    "publish": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true STRIP_TEST_IDS=1 electron-forge publish",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "bun run typecheck:node && bun run typecheck:web && bun run typecheck:shared && bun run typecheck:brave-search && bun run typecheck:web-reader && bun run typecheck:secret-detect && bun run typecheck:streaming-markdown && bun run typecheck:agent-guard && bun run typecheck:logger",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:shared": "tsc --noEmit -p packages/shared/tsconfig.json --composite false",
    "typecheck:brave-search": "tsc --noEmit -p packages/brave-search/tsconfig.json --composite false",
    "typecheck:web-reader": "tsc --noEmit -p packages/web-reader/tsconfig.json --composite false",
    "typecheck:secret-detect": "tsc --noEmit -p packages/secret-detect/tsconfig.json --composite false",
    "typecheck:streaming-markdown": "tsc --noEmit -p packages/streaming-markdown/tsconfig.json --composite false",
    "typecheck:agent-guard": "tsc --noEmit -p packages/agent-guard/tsconfig.json --composite false",
    "typecheck:logger": "tsc --noEmit -p packages/logger/tsconfig.json --composite false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:staged": "env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE -u GIT_PREFIX -u GIT_OBJECT_DIRECTORY vitest related --run --passWithNoTests $(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.mts')",
    "i18n:check": "bun run scripts/i18n-check.ts",
    "i18n:status": "bun run scripts/i18n-status.ts",
    "prepare": "husky",
    "build:helper": "xcrun swiftc -O -o resources/bin/actovia-input helper-src/actovia-input/main.swift -target arm64-apple-macos13",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test --project=api",
    "test:e2e:electron": "electron-forge package && playwright test --project=e2e",
    "test:e2e:providers": "playwright test --project=providers",
    "db:generate": "drizzle-kit generate",
    "icons": "node scripts/render-icons.mjs"
  },
  "dependencies": {
    "@actovia-ai/agent-guard": "workspace:*",
    "@actovia-ai/brave-search": "workspace:*",
    "@actovia-ai/logger": "workspace:*",
    "@actovia-ai/secret-detect": "workspace:*",
    "@actovia-ai/streaming-markdown": "workspace:*",
    "@actovia-ai/web-reader": "workspace:*",
    "@actovia/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@base-ui/react": "^1.9.0",
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@duckdb/node-api": "1.5.6-r.2",
    "@earendil-works/pi-agent-core": "^1.3.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-pgmq": "^0.0.8",
    "@electric-sql/pglite-pgvector": "^0.0.11",
    "@googlemaps/places": "^3.1.0",
    "@hono/node-server": "^2.1.5",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",

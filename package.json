    "react-resizable-panels": "^4.14.8",
    "recharts": "3.10.1",
    "reflect-metadata": "^0.2.2",
    "remend": "^1.4.0",
    "remove-markdown": "^0.8.0",
    "sucrase": "^3.35.1",
    "tailwindcss": "^4.3.3",
    "thinking-orbs": "^0.3.2",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "update-electron-app": "^3.3.0",
    "uuid": "^14.0.3",
    "voice-glow": "^0.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {

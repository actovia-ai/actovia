{
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "forge.config.ts",
    "scripts/mac-update-feed.ts",
    "forge.env.d.ts",
    "vite.main.config.mts",
    "vite.preload.config.mts",
    "packages/shared/src/i18n/types.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "types": ["node", "vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist"
  }
}
